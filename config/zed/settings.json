// Zed settings, ported from config/vscode/settings.json.
{
  "theme": { "mode": "dark", "light": "One Light", "dark": "Tokyo Night" },
  "auto_install_extensions": { "tokyo-night": true, "toml": true, "dockerfile": true, "html": true },

  "vim_mode": true,
  // which-key: popup showing pending vim-style bindings after a prefix key.
  "which_key": { "enabled": true, "delay_ms": 300 },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 20,
  "buffer_line_height": { "custom": 1.55 },
  "buffer_font_features": { "calt": false },
  "cursor_blink": false,
  "cursor_shape": "bar",
  "scroll_beyond_last_line": "off",
  "show_whitespaces": "selection",
  "hover_popover_delay": 1200,
  "inlay_hints": { "enabled": false },
  "minimap": { "show": "always" },
  "sticky_scroll": { "enabled": true },
  "max_tabs": 16,
  "remove_trailing_whitespace_on_save": false,
  "ensure_final_newline_on_save": false,

  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_size": 20,
    "font_features": { "calt": true },
    "max_scroll_history_lines": 20000,
    "dock": "bottom"
  },

  "project_panel": { "dock": "left", "indent_size": 12, "auto_fold_dirs": true },
  "file_scan_exclusions": [
    "**/.git", "**/.svn", "**/.hg", "**/.DS_Store", "**/Thumbs.db",
    "**/node_modules", "**/dist", "**/build", "**/out", "**/target", "**/obj",
    "**/.venv", "**/venv", "**/__pycache__", "**/.pytest_cache", "**/.ruff_cache",
    "**/.mypy_cache", "**/.next", "**/.turbo", "**/coverage"
  ],

  "git": { "inline_blame": { "enabled": true } },
  "confirm_quit": false,

  // Ruff owns Python: format, safe fixes, imports. A repo's own ruff config wins.
  "format_on_save": "off",
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff", "!pyright", "..."],
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
        { "language_server": { "name": "ruff" } }
      ]
    },
    "JavaScript": { "format_on_save": "on", "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"] },
    "TypeScript": { "format_on_save": "on", "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"] },
    "TSX": { "format_on_save": "on", "formatter": [{ "code_action": "source.fixAll.eslint" }, "prettier"] },
    "JSON": { "format_on_save": "on", "formatter": "prettier" },
    "JSONC": { "format_on_save": "on", "formatter": "prettier" },
    "CSS": { "format_on_save": "on", "formatter": "prettier" },
    "HTML": { "format_on_save": "on", "formatter": "prettier" },
    "Markdown": { "format_on_save": "on", "formatter": "prettier" },
    "YAML": { "format_on_save": "on", "formatter": "prettier" }
  },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          "configurationPreference": "filesystemFirst",
          "configuration": { "format": { "quote-style": "single" } }
        }
      }
    },
    "basedpyright": {
      "settings": { "basedpyright.analysis": { "typeCheckingMode": "basic" } }
    }
  }
}
